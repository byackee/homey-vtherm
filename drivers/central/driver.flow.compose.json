{
  "triggers": [
    {
      "id": "central_mode_changed",
      "title": {
        "en": "The central mode changes",
        "fr": "Le mode central change",
        "nl": "De centrale modus verandert"
      },
      "hint": {
        "en": "Fires whoever made the change — a Flow or the picker. Only a real change fires it: setting the mode it already holds does nothing.",
        "fr": "Se déclenche quelle que soit l'origine du changement — un Flow ou le sélecteur. Seul un vrai changement le déclenche : régler le mode qu'il porte déjà ne fait rien.",
        "nl": "Wordt geactiveerd ongeacht de oorzaak — een Flow of de kiezer. Alleen een echte wijziging activeert hem."
      },
      "tokens": [
        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Central mode",
            "fr": "Mode central",
            "nl": "Centrale modus"
          },
          "example": {
            "en": "auto",
            "fr": "auto",
            "nl": "auto"
          }
        }
      ]
    },
    {
      "id": "boiler_started",
      "title": {
        "en": "The boiler is started",
        "fr": "La chaudière est démarrée",
        "nl": "De ketel wordt gestart"
      },
      "tokens": [
        {
          "name": "emitters",
          "type": "number",
          "title": {
            "en": "Emitters calling",
            "fr": "Émetteurs en demande",
            "nl": "Verwarmingen die vragen"
          },
          "example": 3
        }
      ]
    },
    {
      "id": "boiler_stopped",
      "title": {
        "en": "The boiler is stopped",
        "fr": "La chaudière est arrêtée",
        "nl": "De ketel wordt gestopt"
      }
    }
  ],
  "conditions": [
    {
      "id": "boiler_is_active",
      "title": {
        "en": "The boiler !{{is|is not}} running",
        "fr": "La chaudière !{{tourne|ne tourne pas}}",
        "nl": "De ketel !{{draait|draait niet}}"
      }
    },
    {
      "id": "central_mode_is",
      "title": {
        "en": "The central mode !{{is|is not}}",
        "fr": "Le mode central !{{est|n'est pas}}",
        "nl": "De centrale modus !{{is|is niet}}"
      },
      "titleFormatted": {
        "en": "The central mode !{{is|is not}} [[mode]]",
        "fr": "Le mode central !{{est|n'est pas}} [[mode]]",
        "nl": "De centrale modus !{{is|is niet}} [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic",
                "fr": "Automatique",
                "nl": "Automatisch"
              }
            },
            {
              "id": "stopped",
              "label": {
                "en": "All stopped",
                "fr": "Tout arrêté",
                "nl": "Alles gestopt"
              }
            },
            {
              "id": "heat_only",
              "label": {
                "en": "Heating only",
                "fr": "Chauffage seul",
                "nl": "Alleen verwarmen"
              }
            },
            {
              "id": "frost",
              "label": {
                "en": "Frost protection",
                "fr": "Hors-gel",
                "nl": "Vorstbeveiliging"
              }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
