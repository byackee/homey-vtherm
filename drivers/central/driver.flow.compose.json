                "nl": "Automatisch"
              }
            },
            {
              "id": "stopped",
              "label": {
                "en": "All stopped",
                "fr": "Tout arrêté",
                "nl": "Alles gestopt"
              }
            },
            {
              "id": "heat_only",
              "label": {
                "en": "Heating only",
                "fr": "Chauffage seul",
                "nl": "Alleen verwarmen"
              }
            },
            {
              "id": "frost",
