{
  "triggers": [
    {
      "id": "demand_started",
      "title": {
        "en": "It starts calling for heat",
        "fr": "Il commence à demander de la chaleur",
        "nl": "Hij begint warmte te vragen"
      },
      "hint": {
        "en": "Fires when this thermostat goes from not needing heat to needing it. Useful to drive a boiler yourself instead of using the central configuration.",
        "fr": "Se déclenche quand ce thermostat passe de « pas besoin » à « besoin de chaleur ». Utile pour piloter une chaudière soi-même plutôt que par la configuration centrale.",
        "nl": "Wordt geactiveerd wanneer deze thermostaat warmte gaat vragen."
      },
      "tokens": [
        {
          "name": "power_percent",
          "type": "number",
          "title": {
            "en": "Heating power",
            "fr": "Puissance de chauffe",
            "nl": "Verwarmingsvermogen"
          },
          "example": 45
        }
      ]
    },
    {
      "id": "demand_stopped",
      "title": {
        "en": "It stops calling for heat",
        "fr": "Il cesse de demander de la chaleur",
        "nl": "Hij stopt met warmte vragen"
      }
    },
    {
      "id": "window_opened",
      "title": {
        "en": "An open window is detected",
        "fr": "Une ouverture est détectée",
        "nl": "Een open raam wordt gedetecteerd"
      },
      "hint": {
        "en": "Fires once the detection is confirmed, after the configured delay — not the instant the contact opens.",
        "fr": "Se déclenche une fois la détection confirmée, après le délai configuré — pas à l'instant où le contact s'ouvre.",
        "nl": "Wordt geactiveerd zodra de detectie is bevestigd, na de ingestelde vertraging."
      }
    },
    {
      "id": "window_closed",
      "title": {
        "en": "The window is closed again",
        "fr": "L'ouverture est refermée",
        "nl": "Het raam is weer dicht"
      }
    },
    {
      "id": "sensor_went_quiet",
      "title": {
        "en": "The room sensor goes quiet",
        "fr": "Le capteur de pièce se tait",
        "nl": "De kamersensor valt stil"
      },
      "hint": {
        "en": "Fires when no fresh reading has arrived for too long. The thermostat stops asking for heat rather than regulating on a dead value — this is your warning that a battery is flat.",
        "fr": "Se déclenche quand aucune mesure fraîche n'est arrivée depuis trop longtemps. Le thermostat cesse alors de demander de la chaleur plutôt que de réguler sur une valeur morte — c'est votre avertissement qu'une pile est vide.",
        "nl": "Wordt geactiveerd wanneer er te lang geen verse meting is. De thermostaat stopt met warmte vragen."
      }
    }
  ],
  "conditions": [
    {
      "id": "preset_is",
      "title": {
        "en": "The preset !{{is|is not}}",
        "fr": "Le preset !{{est|n'est pas}}",
        "nl": "Het preset !{{is|is niet}}"
      },
      "titleFormatted": {
        "en": "The preset !{{is|is not}} [[preset]]",
        "fr": "Le preset !{{est|n'est pas}} [[preset]]",
        "nl": "Het preset !{{is|is niet}} [[preset]]"
      },
      "args": [
        {
          "name": "preset",
          "type": "dropdown",
          "values": [
            {
              "id": "frost",
              "label": {
                "en": "Frost protection",
                "fr": "Hors-gel",
                "nl": "Vorstbeveiliging"
              }
            },
            {
              "id": "eco",
              "label": {
                "en": "Eco",
                "fr": "Éco",
                "nl": "Eco"
              }
            },
            {
              "id": "comfort",
              "label": {
                "en": "Comfort",
                "fr": "Confort",
                "nl": "Comfort"
              }
            },
            {
              "id": "boost",
              "label": {
                "en": "Boost",
                "fr": "Boost",
                "nl": "Boost"
              }
            },
            {
              "id": "activity",
              "label": {
                "en": "Activity",
                "fr": "Activité",
                "nl": "Activiteit"
              }
            },
            {
              "id": "none",
              "label": {
                "en": "Manual",
                "fr": "Manuel",
                "nl": "Handmatig"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "window_is_open",
      "title": {
        "en": "A window !{{is|is not}} detected open",
        "fr": "Une ouverture !{{est|n'est pas}} détectée",
        "nl": "Een raam !{{is|is niet}} open"
      }
    },
    {
      "id": "is_calling_for_heat",
      "title": {
        "en": "It !{{is|is not}} calling for heat",
        "fr": "Il !{{demande|ne demande pas}} de la chaleur",
        "nl": "Hij !{{vraagt|vraagt geen}} warmte"
      }
    },
    {
      "id": "someone_is_home",
      "title": {
        "en": "Someone !{{is|is not}} home",
        "fr": "Quelqu'un !{{est|n'est pas}} présent",
        "nl": "Iemand !{{is|is niet}} thuis"
      }
    }
  ],
  "actions": [
    {
      "id": "set_preset",
      "title": {
        "en": "Set the preset",
        "fr": "Régler le preset",
        "nl": "Preset instellen"
      },
      "titleFormatted": {
        "en": "Set the preset to [[preset]]",
        "fr": "Régler le preset sur [[preset]]",
        "nl": "Zet het preset op [[preset]]"
      },
      "args": [
        {
          "name": "preset",
          "type": "dropdown",
          "values": [
            {
              "id": "frost",
              "label": {
                "en": "Frost protection",
                "fr": "Hors-gel",
                "nl": "Vorstbeveiliging"
              }
            },
            {
              "id": "eco",
              "label": {
                "en": "Eco",
                "fr": "Éco",
                "nl": "Eco"
              }
            },
            {
              "id": "comfort",
              "label": {
                "en": "Comfort",
                "fr": "Confort",
                "nl": "Comfort"
              }
            },
            {
              "id": "boost",
              "label": {
                "en": "Boost",
                "fr": "Boost",
                "nl": "Boost"
              }
            },
            {
              "id": "activity",
              "label": {
                "en": "Activity",
                "fr": "Activité",
                "nl": "Activiteit"
              }
            },
            {
              "id": "none",
              "label": {
                "en": "Manual",
                "fr": "Manuel",
