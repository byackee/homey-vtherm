              }
            }
          ]
        }
      ]
    },
    {
      "id": "set_preset_timed",
      "title": {
        "en": "Set the preset for a while",
        "fr": "Régler le preset pour un moment",
        "nl": "Preset tijdelijk instellen"
      },
      "titleFormatted": {
        "en": "Set the preset to [[preset]] for [[minutes]] minutes",
        "fr": "Régler le preset sur [[preset]] pendant [[minutes]] minutes",
        "nl": "Zet het preset op [[preset]] voor [[minutes]] minuten"
      },
      "hint": {
        "en": "The previous preset comes back on its own when the time is up. It survives a restart of the app.",
        "fr": "Le preset précédent revient tout seul à l'échéance. Cela survit à un redémarrage de l'app.",
        "nl": "Het vorige preset komt vanzelf terug. Dit overleeft een herstart van de app."
      },
      "args": [
        {
          "name": "preset",
          "type": "dropdown",
          "values": [
            {
              "id": "frost",
              "label": {
                "en": "Frost protection",
                "fr": "Hors-gel",
                "nl": "Vorstbeveiliging"
              }
            },
            {
              "id": "eco",
              "label": {
                "en": "Eco",
                "fr": "Éco",
                "nl": "Eco"
              }
            },
            {
              "id": "comfort",
              "label": {
                "en": "Comfort",
                "fr": "Confort",
                "nl": "Comfort"
              }
            },
            {
              "id": "boost",
              "label": {
                "en": "Boost",
                "fr": "Boost",
                "nl": "Boost"
              }
            },
            {
              "id": "activity",
              "label": {
                "en": "Activity",
                "fr": "Activité",
                "nl": "Activiteit"
              }
            },
            {
              "id": "none",
              "label": {
                "en": "Manual",
                "fr": "Manuel",
                "nl": "Handmatig"
              }
            }
          ]
        },
        {
          "name": "minutes",
          "type": "number",
          "min": 1,
          "max": 1440,
          "step": 1,
          "placeholder": {
            "en": "60",
            "fr": "60",
            "nl": "60"
          }
        }
      ]
    },
    {
      "id": "cancel_timed_preset",
      "title": {
        "en": "Cancel the timed preset",
        "fr": "Annuler le preset temporisé",
        "nl": "Tijdelijk preset annuleren"
      }
    },
    {
      "id": "set_target_temperature",
      "title": {
        "en": "Set the target temperature",
        "fr": "Régler la consigne",
        "nl": "Doeltemperatuur instellen"
      },
      "titleFormatted": {
        "en": "Set the target to [[temperature]] °C",
        "fr": "Régler la consigne à [[temperature]] °C",
        "nl": "Zet het doel op [[temperature]] °C"
      },
      "hint": {
        "en": "Switches the preset to Manual, like turning the dial by hand.",
        "fr": "Bascule le preset sur Manuel, comme si vous tourniez la molette.",
        "nl": "Zet het preset op Handmatig."
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 5,
          "max": 35,
          "step": 0.5
        }
      ]
    },
    {
      "id": "set_window_bypass",
      "title": {
        "en": "Ignore the window detection",
        "fr": "Ignorer la détection d'ouverture",
        "nl": "Raamdetectie negeren"
      },
      "titleFormatted": {
        "en": "[[bypass]] the window detection",
        "fr": "[[bypass]] la détection d'ouverture",
        "nl": "Raamdetectie [[bypass]]"
      },
      "hint": {
        "en": "Keeps heating even with a window detected open. Useful for a room that is aired all day on purpose.",
        "fr": "Continue de chauffer malgré une ouverture détectée. Utile pour une pièce volontairement aérée en continu.",
        "nl": "Blijft verwarmen ondanks een gedetecteerd open raam."
      },
      "args": [
        {
          "name": "bypass",
          "type": "dropdown",
          "values": [
            {
              "id": "on",
              "label": {
                "en": "Ignore",
                "fr": "Ignorer",
                "nl": "Negeren"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "Stop ignoring",
                "fr": "Cesser d'ignorer",
                "nl": "Niet meer negeren"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "force_presence",
      "title": {
        "en": "Force the presence state",
        "fr": "Forcer l'état de présence",
        "nl": "Aanwezigheid forceren"
      },
      "titleFormatted": {
        "en": "Force presence to [[presence]]",
        "fr": "Forcer la présence à [[presence]]",
        "nl": "Forceer aanwezigheid op [[presence]]"
      },
      "args": [
        {
          "name": "presence",
          "type": "dropdown",
          "values": [
            {
              "id": "home",
              "label": {
                "en": "Home",
                "fr": "Présent",
                "nl": "Thuis"
              }
            },
            {
              "id": "away",
              "label": {
                "en": "Away",
                "fr": "Absent",
                "nl": "Afwezig"
              }
            },
            {
              "id": "auto",
              "label": {
                "en": "Back to the sensor",
                "fr": "Revenir au capteur",
                "nl": "Terug naar de sensor"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set_tpi_parameters",
      "title": {
        "en": "Tune the proportional algorithm",
        "fr": "Régler l'algorithme proportionnel",
        "nl": "Proportioneel algoritme afstellen"
      },
      "titleFormatted": {
        "en": "Set the indoor coefficient to [[coef_int]] and the outdoor one to [[coef_ext]]",
        "fr": "Régler le coefficient intérieur à [[coef_int]] et l'extérieur à [[coef_ext]]",
        "nl": "Zet de binnencoëfficiënt op [[coef_int]] en de buitencoëfficiënt op [[coef_ext]]"
      },
      "advanced": true,
      "args": [
        {
          "name": "coef_int",
          "type": "number",
          "min": 0,
          "max": 2,
          "step": 0.01
        },
        {
          "name": "coef_ext",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.001
        }
      ]
    }
  ]
}
