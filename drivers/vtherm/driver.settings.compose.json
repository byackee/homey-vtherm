        "value": 0.5,
        "min": 0,
        "max": 5,
        "step": 0.1,
        "hint": {
          "en": "These valves run on batteries. Below this change, the setpoint is not rewritten.",
          "fr": "Ces vannes sont sur piles. En dessous de cette variation, la consigne n'est pas réécrite.",
          "nl": "Deze kranen werken op batterijen. Onder deze wijziging wordt niets herschreven."
        },
        "units": {
          "en": "°C"
        }
      },
