  {
    "type": "group",
    "label": {
      "en": "Proportional algorithm (TPI)",
      "fr": "Algorithme proportionnel (TPI)",
      "nl": "Proportioneel algoritme (TPI)"
    },
    "children": [
      {
        "id": "tpi_coef_int",
        "type": "number",
        "label": {
          "en": "Indoor coefficient",
          "fr": "Coefficient intérieur",
          "nl": "Binnencoëfficiënt"
        },
        "value": 0.6,
        "min": 0,
        "max": 2,
        "step": 0.01,
        "hint": {
          "en": "Reacts to the gap with the room. Room warms too slowly: raise it. Temperature oscillates around the target: lower it.",
          "fr": "Réagit à l'écart avec la pièce. La pièce monte trop lentement : augmentez. La température oscille autour de la consigne : diminuez.",
          "nl": "Reageert op het verschil met de kamer. Te traag: verhogen. Slingert rond het doel: verlagen."
        }
      },
      {
        "id": "tpi_coef_ext",
        "type": "number",
        "label": {
          "en": "Outdoor coefficient",
          "fr": "Coefficient extérieur",
          "nl": "Buitencoëfficiënt"
        },
        "value": 0.01,
        "min": 0,
        "max": 1,
        "step": 0.001,
        "hint": {
          "en": "Compensates heat loss. Target never reached at steady state: raise it. Target overshot: lower it. Has no effect without an outdoor sensor.",
          "fr": "Compense les pertes. Consigne jamais atteinte en régime stable : augmentez. Consigne dépassée : diminuez. Sans effet si aucun capteur extérieur n'est lié.",
          "nl": "Compenseert warmteverlies. Doel nooit bereikt: verhogen. Doel overschreden: verlagen. Geen effect zonder buitensensor."
        }
      },
      {
        "id": "cycle_min",
        "type": "number",
        "label": {
          "en": "Recalculation period",
          "fr": "Période de recalcul",
          "nl": "Herberekeningsperiode"
        },
        "value": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "hint": {
          "en": "5 minutes suits radiators. Underfloor heating and central heating are slower: 15 to 30 minutes.",
          "fr": "5 minutes conviennent à un radiateur. Un plancher chauffant ou un circuit de chaudière sont plus lents : 15 à 30 minutes.",
          "nl": "5 minuten past bij radiatoren. Vloerverwarming is trager: 15 tot 30 minuten."
        },
        "units": {
          "en": "min"
        }
      },
      {
        "id": "tpi_threshold_high",
        "type": "number",
        "label": {
          "en": "Overshoot threshold while warming",
          "fr": "Seuil de dépassement en montée",
          "nl": "Overschrijdingsdrempel bij opwarmen"
        },
        "value": 0,
        "min": 0,
        "max": 5,
        "step": 0.1,
        "hint": {
          "en": "Cuts heating when the room is this far above target AND still warming. Zero disables both thresholds — they work as a pair.",
          "fr": "Coupe la chauffe quand la pièce dépasse la consigne de cet écart ET continue de monter. Zéro désactive les deux seuils — ils vont par paire.",
          "nl": "Stopt verwarming bij deze overschrijding terwijl het nog opwarmt. Nul schakelt beide drempels uit."
        },
        "units": {
          "en": "°C"
        }
      },
      {
        "id": "tpi_threshold_low",
        "type": "number",
        "label": {
          "en": "Overshoot threshold while cooling",
          "fr": "Seuil de dépassement en descente",
          "nl": "Overschrijdingsdrempel bij afkoelen"
        },
        "value": 0,
        "min": 0,
        "max": 5,
        "step": 0.1,
        "units": {
          "en": "°C"
        }
      }
    ]
  },
