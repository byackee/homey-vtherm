{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": ".homeybuild/",
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["app.mts", "api.mts", "lib/**/*.mts", "runtime/**/*.mts", "drivers/**/*.mts"],
  "exclude": ["node_modules", ".homeybuild", ".testbuild"]
}
