{
  "id": "com.dataweavelabs.adaptivethermostat",
  "version": "1.0.3",
  "compatibility": ">=12.7.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#E8590C",
  "name": {
    "en": "Adaptive Thermostat",
    "fr": "Adaptive Thermostat",
    "nl": "Adaptive Thermostat"
  },
  "description": {
    "en": "Turn any temperature sensor and any heater into a thermostat that actually regulates",
    "fr": "Transformez n'importe quel capteur et n'importe quel émetteur en thermostat qui régule vraiment",
    "nl": "Maak van elke temperatuursensor en verwarming een thermostaat die echt regelt"
  },
  "category": [
    "climate"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getBrokerStatus": {
      "method": "GET",
      "path": "/broker/status",
      "role": "owner"
    },
    "testBroker": {
      "method": "POST",
      "path": "/broker/test",
      "role": "owner"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics",
      "role": "owner"
    },
    "getThermostats": {
      "method": "GET",
      "path": "/thermostats",
      "role": "owner"
    },
    "getSourceCandidates": {
      "method": "GET",
      "path": "/candidates",
      "role": "owner"
    },
    "setThermostatSource": {
      "method": "PUT",
      "path": "/thermostats/source",
      "role": "owner"
    }
  },
  "tags": {
    "en": [
      "thermostat",
      "heating",
      "tpi",
      "radiator valve",
      "boiler",
      "radiator",
      "trv",
      "proportional"
    ],
    "fr": [
      "thermostat",
      "chauffage",
      "tpi",
      "vanne",
      "chaudière",
      "radiateur",
      "trv",
      "proportionnel"
    ],
    "nl": [
      "thermostaat",
      "verwarming",
      "tpi",
      "radiatorkraan",
      "ketel",
      "radiator",
      "proportioneel"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DataWeave Labs"
  },
  "support": "https://community.homey.app/t/app-pro-adaptive-thermostat-proportional-heating-from-any-sensor-and-any-heater/158634",
  "homeyCommunityTopicId": 158634,
  "source": "https://github.com/byackee/homey-vtherm",
  "bugs": {
    "url": "https://github.com/byackee/homey-vtherm/issues"
  }
}
